{
  "name": "securitycorp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "next build",
    "start": "serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test lib/*.test.ts",
    "design:audit": "impeccable detect --json app components",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build:pages && npm run check:draft-isolation",
    "check:draft-isolation": "node scripts/check-draft-isolation.ts",
    "guard:release": "node scripts/check-release-guard.ts",
    "audit:knowledge-tags": "node scripts/audit-knowledge-tags.ts",
    "check:public-terms": "node scripts/check-prohibited-public-terms.ts",
    "check:privacy-leak-gate": "node scripts/check-privacy-leak-gate.ts",
    "check:citations": "node scripts/check-citations.ts",
    "check:security-txt": "node scripts/check-security-txt-expiry.ts"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "next": "16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.180.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "impeccable": "3.6.0",
    "serve": "^14.2.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "SecurityCorp"
