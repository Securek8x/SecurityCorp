/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=86400

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/build-info.json
  Cache-Control: no-cache

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# next/og's ImageResponse (app/**/opengraph-image.tsx) compiles to a route
# handler, so under `output: "export"` the static file it produces has no
# extension (out/knowledge/<slug>/opengraph-image, not .../opengraph-
# image.png) — Cloudflare Pages otherwise infers Content-Type from the
# file extension and serves it as application/octet-stream, which social
# platforms reject as a share-card image. Same root cause the site's
# original single static /opengraph-image.png already worked around (see
# lib/seo.ts's comment); these three explicit overrides do the same for
# the per-page dynamic images (securitycorp-source-wq4).
/knowledge/*/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600

/guides/*/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600

/projects/*/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600
